# Cloudflare Pages header rules.

# index.html is the file that points at the versioned app.js, so it must always
# be re-checked. If it goes stale the browser keeps loading the old build and no
# deployment can reach the app, however many times it is reopened.
/*
  Cache-Control: public, max-age=0, must-revalidate

# These are requested as ?v=<version>, stamped by build.sh, so every release is a
# URL the browser has not seen. A given copy can safely be kept forever.
/app.js
  Cache-Control: public, max-age=31536000, immutable
/styles.css
  Cache-Control: public, max-age=31536000, immutable

# The service worker has to be re-checked too, or push handling can never update.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
